# Configuração do comedouro. Copie para `.env` (na raiz do repo) e preencha.
# O `.env` não vai para o git. Cada item está explicado em docs/GUIA.md.
#
# Sem nenhum `.env`, o servidor sobe no MODO DEMONSTRAÇÃO:
# dispositivo simulado, dados em memória e sem notificações.

# --- Aparelhos (ESP32) ------------------------------------------------------
# Com estas três linhas, o servidor abre um broker MQTT nesta porta, e dá para
# adicionar comedouros do tipo "Tenho um aparelho". Cada aparelho entra com o
# usuário e a senha que o app mostra ao criá-lo; o usuário e a senha abaixo são
# só do próprio servidor.
# Sem a porta, só dá para criar comedouros simulados.
MQTT_BROKER_PORT=1883
MQTT_USERNAME=servidor
MQTT_PASSWORD=troque-esta-senha

# --- Banco de dados ---------------------------------------------------------
# Com o Docker Compose, não precisa: o compose já aponta para o MongoDB dele.
# Rodando o servidor fora do Docker (`pnpm dev`), descomente para guardar os
# dados no MongoDB do compose (`docker compose up -d mongo`).
# Sem MONGO_URL, os dados ficam em memória e somem ao reiniciar.
# MONGO_URL=mongodb://127.0.0.1:27017
# MONGO_DB=comedouro

# --- Notificações push ------------------------------------------------------
# Gere o par de chaves uma vez: `pnpm vapid`, dentro de `server/`.
# Sem as chaves, os avisos aparecem só no app e no log do servidor.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Um contato seu, exigido pelos serviços de push: mailto:voce@exemplo.com
VAPID_SUBJECT=

# --- Login -----------------------------------------------------------------
# O "ID do cliente OAuth" do Google (passo a passo em docs/GUIA.md, seção 3.5).
# Sem ele, o botão "Continuar com o Google" não aparece.
GOOGLE_CLIENT_ID=
# "Entrar como dev", sem Google. No Docker vem desligado; ligue para o modo
# demonstração. NUNCA ligue num servidor aberto na internet.
# DEV_LOGIN=true
# Cookie da sessão só por HTTPS. No Docker vem ligado. Desligue só para abrir
# o app por http:// com o IP da máquina, na rede de casa.
# COOKIE_SECURE=false

# --- Servidor ---------------------------------------------------------------
# PORT=3000
# HOST=0.0.0.0
# LOG_LEVEL=info

# --- Só no modo demonstração ------------------------------------------------
# Depois de quantos minutos o "gato" esvazia a tigela (0 = nunca).
# SIM_CAT_EATS_MINUTES=10
