# Configuração do comedouro. Copie para `.env` (na raiz do repo) e preencha.
# O `.env` não vai para o git. Cada item está explicado em docs/GUIA.md.
#
# Sem nenhum `.env`, o servidor sobe no MODO DEMONSTRAÇÃO:
# dispositivo simulado, dados em memória e sem notificações.

# --- Dispositivo (ESP32) ----------------------------------------------------
# Com estas três linhas, o servidor abre um broker MQTT nesta porta, e o ESP32
# (ou o simulador) conecta nele com este usuário e esta senha.
# Sem a porta, o servidor usa o dispositivo simulado e nenhum ESP32 é controlado.
MQTT_BROKER_PORT=1883
MQTT_USERNAME=comedouro
MQTT_PASSWORD=troque-esta-senha

# Para usar um broker que já existe (um Mosquitto, por exemplo), apague a
# MQTT_BROKER_PORT acima e informe o endereço dele:
# MQTT_URL=mqtt://192.168.0.10:1883

# O nome do alimentador nos tópicos MQTT (alimentador/<FEEDER_ID>/...).
# Tem que ser igual ao configurado no ESP32.
FEEDER_ID=principal

# --- Banco de dados ---------------------------------------------------------
# Com o Docker Compose, não precisa: o compose já aponta para o MongoDB dele.
# Rodando o servidor fora do Docker (`pnpm dev`), descomente para guardar os
# dados no MongoDB do compose (`docker compose up -d mongo`).
# Sem MONGO_URL, os dados ficam em memória e somem ao reiniciar.
# MONGO_URL=mongodb://127.0.0.1:27017
# MONGO_DB=comedouro

# --- Notificações push ------------------------------------------------------
# Gere o par de chaves uma vez: `pnpm vapid`, dentro de `server/`.
# Sem as chaves, os avisos aparecem só no app e no log do servidor.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Um contato seu, exigido pelos serviços de push: mailto:voce@exemplo.com
VAPID_SUBJECT=

# --- Servidor ---------------------------------------------------------------
# PORT=3000
# HOST=0.0.0.0
# LOG_LEVEL=info

# --- Só no modo demonstração ------------------------------------------------
# Depois de quantos minutos o "gato" esvazia a tigela (0 = nunca).
# SIM_CAT_EATS_MINUTES=10
